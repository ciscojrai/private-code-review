# Private Code Review — environment. Copy to .env and fill in. Never commit keys.

# NEAR AI Cloud API key (https://cloud.near.ai → API Keys). When present and
# funded, the review runs on a verified TEE model and carries a provider_tee
# signature + Verification Center receipt. When absent or at $0.00 (HTTP 402),
# the worker falls back to local MLX (honestly labeled UNVERIFIED).
NEARAI_API_KEY=

# Optional: a local Apple-Silicon MLX server (OpenAI-compatible) used as the
# dev fallback when NEARAI_API_KEY has no credits.
MLX_URL=http://127.0.0.1:8080/v1
MLX_MODEL=local-mlx
